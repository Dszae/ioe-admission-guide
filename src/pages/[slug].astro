---
import Layout from '../layouts/Layout.astro';
import App, { type TabId } from '../components/App';

const pages: Record<string, [string, string, string]> = {
  profile: ['Dipesh Sapkota | Creator of IOE Predictor & IOE Admission Hub', 'Learn about Dipesh Sapkota, the software developer and creator of IOE Predictor and IOE Admission Hub in Nepal. Explore his background, developer story, and engineering tools.', 'Dipesh Sapkota — Developer & Creator of IOE Predictor'],
  predictor: ['IOE Rank Predictor & Historical Cutoffs | IOE Admission Hub', 'Compare IOE entrance merit ranks with official historical closing ranks by campus, program, fee category, and quota on IOE Admission Hub.', 'IOE Rank Predictor and Historical Closing Ranks'],
  campuses: ['IOE Constituent Campuses & 2,040 Seat Matrix | IOE Admission Hub', 'IOE constituent campus profiles, programs, facilities, and 2,040 seat matrix capacities for Pulchowk, Thapathali, WRC, ERC, and Chitwan.', 'IOE Constituent Campuses and Seat Matrix'],
  calculator: ['IOE CBT Score Calculator (Negative Marking) | IOE Admission Hub', 'Calculate IOE CBT marks, duration, 40% pass threshold, and exact 10% negative-marking penalty rules on IOE Admission Hub.', 'IOE CBT Score Calculator and Negative Marking Rules'],
  estimator: ['IOE Score-to-Rank Estimator & Merit Curves | IOE Admission Hub', 'Estimate historical IOE entrance merit-rank brackets from raw CBT exam scores using benchmark percentile curves on IOE Admission Hub.', 'IOE Score-to-Rank Estimator'],
  priority: ['IOE Priority Form Optimizer & Counseling Strategy | IOE Admission Hub', 'Build an algorithmic Reach, Target, and Safety IOE counseling preference sequence using historical cutoff data on IOE Admission Hub.', 'IOE Priority Form Optimizer'],
  guide: ['IOE Admission Guide & Counseling Handbook (2083/084) | IOE Admission Hub', 'Comprehensive IOE counseling handbook: merit-list rounds, auto-upgrade rules, physical document verification, and affirmative action quotas.', 'IOE Admission Guide and Counseling Handbook'],
  checklist: ['IOE Admission Checklist & Document Verification | IOE Admission Hub', 'Track the complete IOE admission process from CBT registration through document verification with an interactive checklist.', 'IOE Admission Checklist'],
  notices: ['IOE Admission Notices, Quota Circulars & Merit Lists | IOE Admission Hub', 'Browse authentic and source-linked IOE entrance and admission notices, circulars, and campus merit lists.', 'IOE Admission Notices and Circulars'],
  affiliated: ['TU-Affiliated Engineering Colleges Directory & Fees | IOE Admission Hub', 'Comprehensive reference directory and fee comparisons for 10 TU-affiliated private engineering colleges in Nepal.', 'TU-Affiliated Engineering Colleges Directory'],
  compare: ['Compare IOE Engineering Disciplines & Career Scope | IOE Admission Hub', 'Compare IOE engineering discipline focus areas, curriculum overlap, and industry career directions on IOE Admission Hub.', 'Compare IOE Engineering Disciplines'],
  financials: ['IOE Engineering Tuition Fees & Living Costs Breakdown | IOE Admission Hub', 'Compare 4-year tuition costs between IOE Regular and Full Fee schemes, hostel expenses, and living cost estimates on IOE Admission Hub.', 'IOE Engineering Tuition Fees and Living Costs']
};

export function getStaticPaths() {
  return [
    'profile',
    'predictor',
    'campuses',
    'calculator',
    'estimator',
    'priority',
    'guide',
    'checklist',
    'notices',
    'affiliated',
    'compare',
    'financials'
  ].map((slug) => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props;
const page = pages[slug] || pages.predictor;
const [title, description, heading] = page;
const site = 'https://ioe-admission.dipeshsapkota7.com.np';
const canonical = `${site}/${slug}/`;
---
<Layout title={title} description={description} canonical={canonical} heading={heading} schemaType={slug === 'profile' ? 'ProfilePage' : 'WebPage'}>
  <App client:load initialTab={slug as TabId} />
</Layout>
