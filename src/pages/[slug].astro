---
import Layout from '../layouts/Layout.astro';
import App, { type TabId } from '../components/App';

const pages: Record<string, [string, string, string]> = {
  profile: ['IOE Admission Hub Profile | Dipesh Sapkota', 'Profile of the independent IOE admission guide created by Dipesh Sapkota.', 'IOE Admission Hub profile'],
  predictor: ['IOE Rank Predictor and Historical Cutoffs | IOE Admission Hub', 'Compare IOE merit ranks with historical closing ranks by campus, program, fee category, and quota.', 'IOE rank predictor and historical closing ranks'],
  campuses: ['IOE Campuses and Seat Matrix | IOE Admission Hub', 'IOE constituent campus profiles, programs, facilities, and reference seat capacities.', 'IOE constituent campuses and seat matrix'],
  calculator: ['IOE CBT Score Calculator Rules | IOE Admission Hub', 'Reference the IOE CBT marks, duration, pass threshold, and negative-marking rules.', 'IOE CBT score calculator'],
  estimator: ['IOE Score-to-Rank Estimator | IOE Admission Hub', 'Estimate a historical IOE merit-rank bracket from a raw CBT score.', 'IOE score-to-rank estimator'],
  priority: ['IOE Priority Form Optimizer | IOE Admission Hub', 'Build an IOE counseling preference sequence using historical reference data.', 'IOE priority form optimizer'],
  guide: ['IOE Admission Guide and Counseling Handbook | IOE Admission Hub', 'Read IOE counseling, auto-upgrade, quota, document, and verification guidance.', 'IOE admission guide'],
  checklist: ['IOE Admission Checklist | IOE Admission Hub', 'Track the IOE admission process from entrance registration through verification.', 'IOE admission checklist'],
  notices: ['IOE Admission Notices and Circulars | IOE Admission Hub', 'Browse source-linked IOE entrance and admission notices and circulars.', 'IOE admission notices'],
  affiliated: ['TU-Affiliated Engineering Colleges | IOE Admission Hub', 'Compare reference information for TU-affiliated private engineering colleges.', 'TU-affiliated engineering colleges'],
  compare: ['Compare IOE Engineering Disciplines | IOE Admission Hub', 'Compare IOE engineering discipline focus areas and career directions.', 'Compare IOE engineering disciplines'],
  financials: ['IOE Engineering Fees and Living Costs | IOE Admission Hub', 'Compare reference tuition and living costs across IOE engineering paths.', 'IOE engineering fees and living costs']
};

export function getStaticPaths() {
  return [
    'profile',
    'predictor',
    'campuses',
    'calculator',
    'estimator',
    'priority',
    'guide',
    'checklist',
    'notices',
    'affiliated',
    'compare',
    'financials'
  ].map((slug) => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props;
const page = pages[slug] || pages.predictor;
const [title, description, heading] = page;
const site = 'https://ioe-admission.dipeshsapkota7.com.np';
const canonical = `${site}/${slug}/`;
---
<Layout title={title} description={description} canonical={canonical} heading={heading} schemaType={slug === 'profile' ? 'ProfilePage' : 'WebPage'}>
  <App client:load initialTab={slug as TabId} />
</Layout>
