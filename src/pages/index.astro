---
import Layout from '../layouts/Layout.astro';
import App from '../components/App';

const title = 'IOE Admission Hub | Rank Predictor, Campus Explorer & Guide';
const description = 'IOE Admission Hub by Dipesh Sapkota: a comprehensive admission toolkit for Tribhuvan University Institute of Engineering (IOE) applicants in Nepal. Predict ranks, explore seats, and plan priorities.';
const canonical = 'https://ioe-admission.dipeshsapkota7.com.np/';
---
<Layout title={title} description={description} canonical={canonical} heading="IOE Admission Hub">
  <App client:load initialTab="predictor" />
</Layout>
