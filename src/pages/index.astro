---
import Layout from '../layouts/Layout.astro';
import App from '../components/App';

const title = 'IOE Admission Hub | IOE Predictor, Entrance Guide, Syllabus, Marks Calculator, Campuses & Fees';
const description = 'The premier IOE admission hub & predictor for Tribhuvan University engineering applicants in Nepal. Access official IOE entrance syllabus, 140-mark CBT calculator with negative marking, 2,040 campus seat matrices, fee structures, and merit cutoffs.';
const canonical = 'https://ioe-admission.dipeshsapkota7.com.np/';
---
<Layout title={title} description={description} canonical={canonical} heading="IOE Admission Hub | Central IOE Predictor, Entrance Guide & Syllabus">
  <App client:load initialTab="predictor" />
</Layout>
