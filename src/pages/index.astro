---
import Layout from '../layouts/Layout.astro';
import App from '../components/App';

const title = 'IOE Admission Hub | Central IOE Admission Guide, Rank Predictor & CBT Calculator';
const description = 'IOE Admission Hub: the premier central admission portal for Tribhuvan University Institute of Engineering (IOE) applicants in Nepal. Predict entrance ranks, explore 2,040 constituent seats, calculate CBT negative marking scores, and optimize counseling priority.';
const canonical = 'https://ioe-admission.dipeshsapkota7.com.np/';
---
<Layout title={title} description={description} canonical={canonical} heading="IOE Admission Hub | Central IOE Admission Guide & Rank Predictor">
  <App client:load initialTab="predictor" />
</Layout>
