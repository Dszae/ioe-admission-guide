---
import Layout from '../layouts/Layout.astro';
import App from '../components/App';

const title = 'IOE Admission Hub by Dipesh Sapkota | Rank Predictor, Seat Matrix & Guide';
const description = 'IOE Admission Hub by Dipesh Sapkota: the premier independent admission toolkit for Tribhuvan University Institute of Engineering (IOE) applicants in Nepal. Predict merit ranks, explore 2,040 constituent seats, calculate CBT scores, and optimize counseling priority.';
const canonical = 'https://ioe-admission.dipeshsapkota7.com.np/';
---
<Layout title={title} description={description} canonical={canonical} heading="IOE Admission Hub by Dipesh Sapkota">
  <App client:load initialTab="predictor" />
</Layout>
