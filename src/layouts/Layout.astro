---
import '../index.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  heading: string;
  schemaType?: 'WebPage' | 'ProfilePage';
}

const { title, description, canonical, heading, schemaType = 'WebPage' } = Astro.props;
const site = 'https://ioe-admission.dipeshsapkota7.com.np';

const isCalculator = canonical.includes('/calculator/');
const isPredictor = canonical.includes('/predictor/') || canonical === `${site}/`;
const isGuide = canonical.includes('/guide/');
const isProfile = schemaType === 'ProfilePage' || canonical.includes('/profile/');

const breadcrumbElements = canonical === `${site}/`
  ? [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'IOE Admission Hub by Dipesh Sapkota',
        item: `${site}/`
      }
    ]
  : canonical === `${site}/profile/`
  ? [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'IOE Admission Hub',
        item: `${site}/`
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Dipesh Sapkota',
        item: `${site}/profile/`
      }
    ]
  : [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'IOE Admission Hub',
        item: `${site}/`
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Dipesh Sapkota',
        item: `${site}/profile/`
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: heading,
        item: canonical
      }
    ];

const structuredData: {
  '@context': string;
  '@graph': Array<Record<string, unknown>>;
} = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://www.dipeshsapkota7.com.np/#author',
      name: 'Dipesh Sapkota',
      alternateName: ['Dipesh Sapkota', 'Dszae'],
      url: 'https://www.dipeshsapkota7.com.np/',
      image: `${site}/dipesh-sapkota-profile.webp`,
      jobTitle: 'Creator & Builder of IOE Admission Hub',
      description: 'Creator and builder of IOE Admission Hub, an independent entrance and admission guide for Institute of Engineering (TU) applicants in Nepal.',
      worksFor: {
        '@type': 'Organization',
        name: 'IOE Admission Hub',
        url: `${site}/`
      },
      sameAs: [
        'https://github.com/Dszae',
        'https://www.linkedin.com/in/dipesh-sapkota/',
        'https://instagram.com/dsz.ae',
        'https://www.dipeshsapkota7.com.np/'
      ],
      knowsAbout: [
        'Tribhuvan University IOE Entrance Examination',
        'IOE Merit Rank Prediction & Counseling',
        'IOE CBT Scoring & Negative Marking Rules',
        'IOE Campus Quotas & 2,040 Seats Matrix',
        'Student Counseling Guidance & Verification'
      ]
    },
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      url: `${site}/`,
      name: 'IOE Admission Hub by Dipesh Sapkota',
      alternateName: [
        'IOE Admission Hub',
        'IOE Rank Predictor by Dipesh Sapkota',
        'Dipesh Sapkota IOE Guide',
        'IOE Predictor'
      ],
      description: 'Comprehensive admission toolkit, rank predictor, and counseling handbook for TU Institute of Engineering applicants in Nepal by Dipesh Sapkota.',
      isPartOf: {
        '@type': 'WebSite',
        '@id': 'https://www.dipeshsapkota7.com.np/#website',
        name: 'Dipesh Sapkota',
        url: 'https://www.dipeshsapkota7.com.np/'
      },
      publisher: {
        '@id': 'https://www.dipeshsapkota7.com.np/#author'
      },
      author: {
        '@id': 'https://www.dipeshsapkota7.com.np/#author'
      },
      creator: {
        '@id': 'https://www.dipeshsapkota7.com.np/#author'
      },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${site}/predictor/?rank={search_term_string}`
        },
        'query-input': 'required name=search_term_string'
      },
      hasPart: [
        {
          '@type': 'WebPage',
          '@id': `${site}/profile/#webpage`,
          name: 'Dipesh Sapkota',
          url: `${site}/profile/`
        },
        {
          '@type': 'WebPage',
          '@id': `${site}/predictor/#webpage`,
          name: 'IOE Rank Predictor & Historical Cutoffs',
          url: `${site}/predictor/`
        },
        {
          '@type': 'WebPage',
          '@id': `${site}/campuses/#webpage`,
          name: 'IOE Constituent Campuses & Seat Matrix',
          url: `${site}/campuses/`
        },
        {
          '@type': 'WebPage',
          '@id': `${site}/calculator/#webpage`,
          name: 'IOE CBT Negative Marking Calculator',
          url: `${site}/calculator/`
        },
        {
          '@type': 'WebPage',
          '@id': `${site}/estimator/#webpage`,
          name: 'IOE Score-to-Rank Estimator',
          url: `${site}/estimator/`
        },
        {
          '@type': 'WebPage',
          '@id': `${site}/priority/#webpage`,
          name: 'IOE Priority Form Optimizer',
          url: `${site}/priority/`
        },
        {
          '@type': 'WebPage',
          '@id': `${site}/guide/#webpage`,
          name: 'IOE Admission Guide & Counseling Handbook',
          url: `${site}/guide/`
        }
      ]
    },
    {
      '@type': 'ItemList',
      '@id': `${site}/#site-navigation`,
      name: 'IOE Admission Hub Main Sitelinks Navigation',
      itemListElement: [
        {
          '@type': 'SiteNavigationElement',
          position: 1,
          name: 'IOE Rank Predictor',
          description: 'Compare merit rank against historical closing ranks across constituent campuses.',
          url: `${site}/predictor/`
        },
        {
          '@type': 'SiteNavigationElement',
          position: 2,
          name: 'Dipesh Sapkota',
          description: 'Personal profile and background of Dipesh Sapkota, creator and builder of IOE Admission Hub.',
          url: `${site}/profile/`
        },
        {
          '@type': 'SiteNavigationElement',
          position: 3,
          name: 'IOE CBT Calculator',
          description: 'Calculate exact CBT score out of 140 with official negative marking rules.',
          url: `${site}/calculator/`
        },
        {
          '@type': 'SiteNavigationElement',
          position: 4,
          name: 'Campuses & Seat Matrix',
          description: 'Constituent campus profiles and 2,040 seat matrix breakdown.',
          url: `${site}/campuses/`
        },
        {
          '@type': 'SiteNavigationElement',
          position: 5,
          name: 'Priority Optimizer',
          description: 'Build optimal Reach, Target, and Safety counseling preferences.',
          url: `${site}/priority/`
        },
        {
          '@type': 'SiteNavigationElement',
          position: 6,
          name: 'Admission Guide',
          description: 'Step-by-step IOE counseling, auto-upgrade rules, and document verification.',
          url: `${site}/guide/`
        }
      ]
    },
    {
      '@type': schemaType,
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: 'en',
      isPartOf: {
        '@id': `${site}/#website`
      },
      author: {
        '@id': 'https://www.dipeshsapkota7.com.np/#author'
      },
      creator: {
        '@id': 'https://www.dipeshsapkota7.com.np/#author'
      },
      ...(isProfile ? {
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: `${site}/dipesh-sapkota-profile.webp`,
          caption: 'Dipesh Sapkota — Creator of IOE Admission Hub'
        },
        mainEntity: {
          '@id': 'https://www.dipeshsapkota7.com.np/#author'
        },
        about: {
          '@id': 'https://www.dipeshsapkota7.com.np/#author'
        }
      } : {}),
      breadcrumb: {
        '@id': `${canonical}#breadcrumbs`
      }
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumbs`,
      itemListElement: breadcrumbElements
    }
  ]
};

if (isPredictor || isCalculator) {
  structuredData['@graph'].push({
    '@type': 'WebApplication',
    '@id': `${canonical}#app`,
    name: title,
    url: canonical,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript. Requires HTML5.',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'NPR'
    },
    author: {
      '@id': 'https://www.dipeshsapkota7.com.np/#author'
    },
    creator: {
      '@id': 'https://www.dipeshsapkota7.com.np/#author'
    },
    publisher: {
      '@id': 'https://www.dipeshsapkota7.com.np/#author'
    }
  });
}

if (isGuide) {
  structuredData['@graph'].push({
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How does the IOE entrance CBT negative marking system work?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The IOE CBT entrance exam totals 140 marks with a 10% penalty for incorrect answers: -0.1 mark per wrong 1-mark question and -0.2 mark per wrong 2-mark question. Unattempted questions incur no penalty. A minimum of 40% (56 marks) is strictly required to pass.'
        }
      },
      {
        '@type': 'Question',
        name: 'How does the IOE auto-upgrade counseling system work?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'When a candidate is allotted a seat of a lower priority preference in an earlier merit list round, any seat vacancy in their higher priority choices automatically shifts them upward in subsequent rounds. Downgrading to a lower preference is not permitted.'
        }
      },
      {
        '@type': 'Question',
        name: 'What documents are required for IOE physical campus verification?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Candidates must submit their IOE entrance admit card, original citizenship or national ID, SLC/SEE grade sheet & character certificate, +2/diploma transcript & migration certificate, 4 passport photos, and official quota endorsement letters if claiming affirmative action seats.'
        }
      }
    ]
  });
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1e40af" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/png" href="/ioe-logo.png" />
    <link rel="alternate icon" type="image/png" href="/ioe logo.png" />
    <link rel="apple-touch-icon" href="/ioe-logo.png" />
    <link rel="author" href="https://www.dipeshsapkota7.com.np/" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Full context for AI agents" />

    <!-- Google Fonts: Manrope & IBM Plex Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Dipesh Sapkota" />
    <meta name="creator" content="Dipesh Sapkota" />
    <meta name="publisher" content="Dipesh Sapkota" />
    <meta name="keywords" content="Dipesh Sapkota, Dipesh Sapkota IOE, IOE predictor Dipesh Sapkota, IOE admission hub Dipesh Sapkota, IOE rank predictor, IOE entrance 2081 2082, Pulchowk campus cutoffs, IOE CBT calculator, TU engineering admission Nepal" />
    <meta name="geo.region" content="NP" />
    <meta name="geo.placename" content="Kathmandu, Nepal" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="google-site-verification" content="wtQe5iJTyPSo0Nrj7GN4IteUky0stRBG7tIB1Lu92P8" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IOE Admission Hub by Dipesh Sapkota" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={isProfile ? `${site}/dipesh-sapkota-profile.webp` : `${site}/og-image.png`} />
    <meta property="og:image:width" content={isProfile ? "800" : "1200"} />
    <meta property="og:image:height" content={isProfile ? "800" : "630"} />
    <meta property="og:image:alt" content={isProfile ? "Dipesh Sapkota — Creator of IOE Admission Hub" : "IOE Admission Hub by Dipesh Sapkota"} />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:site" content="@Dszae" />
    <meta property="twitter:creator" content="@Dszae" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={isProfile ? `${site}/dipesh-sapkota-profile.webp` : `${site}/og-image.png`} />
    <meta property="twitter:image:alt" content={isProfile ? "Dipesh Sapkota — Creator of IOE Admission Hub" : "IOE Admission Hub by Dipesh Sapkota"} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="bg-slate-50 text-slate-800 font-sans min-h-screen">
    <h1 class="sr-only">{heading}</h1>
    <slot />
  </body>
</html>
