---
import '../index.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  heading: string;
  schemaType?: 'WebPage' | 'ProfilePage';
}

const { title, description, canonical, heading, schemaType = 'WebPage' } = Astro.props;
const site = 'https://ioe-admission.dipeshsapkota7.com.np';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', name: 'IOE Admission Hub', url: site },
  author: { '@type': 'Person', name: 'Dipesh Sapkota', url: 'https://www.dipeshsapkota7.com.np/' },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'IOE Admission Hub', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: heading, item: canonical }
    ]
  }
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IOE Admission Hub" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/og-image.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/og-image.png`} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <style is:global>
      :root { font-family: 'Manrope', system-ui, sans-serif; color: #172033; background: #f6f8fb; }
      body { margin: 0; line-height: 1.6; }
      a { color: #1558b0; }
      .site-header, .site-footer, main { max-width: 1080px; margin-inline: auto; }
      .site-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.25rem; }
      .site-header nav { display: flex; flex-wrap: wrap; gap: 1rem; }
      .brand { display: inline-flex; align-items: center; gap: .6rem; color: #123b84; font-weight: 800; text-decoration: none; }
      main { padding: 1rem 1.25rem 4rem; }
      .breadcrumbs { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 2rem; font-size: .875rem; }
      .intro, .public-page, .content-section, .interactive-shell, .data-section, .source-note { background: #fff; border: 1px solid #d8e0ed; border-radius: 10px; padding: 1.25rem; margin: 1rem 0; }
      .intro { border-top: 4px solid #2563eb; }
      h1 { max-width: 18ch; color: #123b84; line-height: 1.15; }
      h2 { color: #183b70; margin-top: 2rem; }
      .eyebrow { color: #2563eb; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; font-size: .75rem; }
      .lede { max-width: 72ch; }
      .link-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: .75rem; }
      .link-grid a { display: grid; gap: .25rem; padding: 1rem; border: 1px solid #d8e0ed; border-radius: 8px; text-decoration: none; }
      .link-grid span { color: #53657e; font-size: .9rem; }
      table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
      th, td { text-align: left; vertical-align: top; border: 1px solid #d8e0ed; padding: .6rem; }
      th { background: #edf4ff; }
      .site-footer { border-top: 1px solid #d8e0ed; padding: 1.5rem 1.25rem 3rem; color: #53657e; font-size: .9rem; }
      .admission-workspace { display: grid; gap: 1rem; }
      .workspace-tabs, .workspace-switcher { display: flex; flex-wrap: wrap; gap: .5rem; }
      .workspace-tabs { border-bottom: 1px solid #d8e0ed; padding-bottom: .75rem; }
      .workspace-tabs button, .workspace-switcher button { border: 1px solid #c6d2e3; background: #fff; color: #29405f; border-radius: 7px; padding: .65rem .9rem; font: inherit; font-size: .9rem; cursor: pointer; }
      .workspace-tabs button.is-active, .workspace-switcher button.is-active { background: #153e75; color: #fff; border-color: #153e75; }
      .workspace-panel { border: 1px solid #cbd7e6; border-radius: 10px; padding: clamp(1rem, 3vw, 1.5rem); background: #fbfdff; }
      .workspace-heading { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; }
      .workspace-heading h3 { margin: 0; color: #163a6c; font-size: 1.35rem; }
      .workspace-kicker { margin: 0 0 .25rem; color: #2563eb; font-weight: 700; font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; }
      .workspace-chip { border: 1px solid #b9cce5; border-radius: 999px; color: #31577e; padding: .25rem .55rem; font-size: .75rem; white-space: nowrap; }
      .workspace-copy, .workspace-disclaimer { max-width: 70ch; color: #52647c; font-size: .92rem; }
      .workspace-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
      .workspace-field { display: grid; gap: .35rem; color: #263c59; font-size: .85rem; font-weight: 700; }
      .workspace-field input, .workspace-field select { width: 100%; box-sizing: border-box; border: 1px solid #b9c7d9; border-radius: 7px; background: #fff; color: #172033; padding: .7rem .75rem; font: inherit; font-weight: 500; }
      .workspace-field small { color: #64748b; font-weight: 400; }
      .workspace-primary { grid-column: 1 / -1; border: 0; border-radius: 7px; background: #1d5fb8; color: #fff; padding: .8rem 1rem; font: inherit; font-weight: 700; cursor: pointer; }
      .workspace-primary:hover { background: #164c96; }
      .workspace-primary:focus-visible, .workspace-tabs button:focus-visible, .workspace-switcher button:focus-visible { outline: 3px solid #8cc7ff; outline-offset: 2px; }
      .workspace-results { display: grid; gap: .65rem; margin-top: 1rem; }
      .result-card, .score-result { border: 1px solid #cbd7e6; border-left: 4px solid #53708f; border-radius: 7px; padding: .85rem 1rem; background: #fff; }
      .result-card { display: grid; gap: .2rem; }
      .result-card > div { display: flex; justify-content: space-between; gap: 1rem; }
      .result-card span, .score-result span { color: #61738c; font-size: .8rem; }
      .result-card p, .score-result p { margin: .25rem 0 0; color: #52647c; font-size: .88rem; }
      .result-emerald, .score-pass { border-left-color: #14804a; background: #f2fbf6; }
      .result-amber, .result-orange { border-left-color: #b76a00; background: #fffaf0; }
      .result-red, .score-fail { border-left-color: #b42318; background: #fff7f6; }
      .score-result { display: grid; gap: .2rem; margin-top: 1rem; }
      .score-result strong { font-size: 1.55rem; color: #163a6c; }
      .workspace-inline-form { display: grid; grid-template-columns: 1fr auto; gap: 1rem; align-items: end; margin-top: 1rem; }
      .workspace-inline-form .workspace-primary { grid-column: auto; }
      @media (max-width: 640px) { .site-header { align-items: flex-start; flex-direction: column; } table { display: block; overflow-x: auto; white-space: nowrap; } }
      @media (max-width: 640px) { .workspace-grid, .workspace-inline-form { grid-template-columns: 1fr; } .workspace-primary, .workspace-inline-form .workspace-primary { grid-column: auto; } .workspace-heading { flex-direction: column; } }
      @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; } }
    </style>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand"><img src="/ioe-logo.png" width="40" height="40" alt="" /> <span>IOE Admission Hub</span></a>
      <nav aria-label="Primary navigation">
        <a href="/predictor/">Predictor</a>
        <a href="/guide/">Guide</a>
        <a href="/notices/">Notices</a>
        <a href="/profile/">About</a>
      </nav>
    </header>
    <main id="main-content">
      <nav aria-label="Breadcrumb" class="breadcrumbs"><a href="/">IOE Admission Hub</a><span aria-hidden="true">/</span><span aria-current="page">{heading}</span></nav>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Independent educational reference by <a href="https://www.dipeshsapkota7.com.np/">Dipesh Sapkota</a>. Not operated, affiliated with, or endorsed by IOE or Tribhuvan University.</p>
      <p><a href="https://entrance.ioe.edu.np/">Verify current information at the official IOE entrance portal</a>.</p>
    </footer>
  </body>
</html>
