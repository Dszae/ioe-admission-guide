---
import '../index.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  heading: string;
  schemaType?: 'WebPage' | 'ProfilePage';
}

const { title, description, canonical, heading, schemaType = 'WebPage' } = Astro.props;
const site = 'https://ioe-admission.dipeshsapkota7.com.np';

const isCalculator = canonical.includes('/calculator/');
const isPredictor = canonical.includes('/predictor/') || canonical === `${site}/`;
const isGuide = canonical.includes('/guide/');
const isProfile = schemaType === 'ProfilePage' || canonical.includes('/profile/');
const isSyllabus = canonical.includes('/syllabus/');

const breadcrumbElements = canonical === `${site}/`
  ? [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'IOE Admission Hub by Dipesh Sapkota',
        item: `${site}/`
      }
    ]
  : canonical === `${site}/profile/`
  ? [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'IOE Admission Hub',
        item: `${site}/`
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Dipesh Sapkota',
        item: `${site}/profile/`
      }
    ]
  : [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'IOE Admission Hub',
        item: `${site}/`
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Dipesh Sapkota',
        item: `${site}/profile/`
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: heading,
        item: canonical
      }
    ];

const structuredData: {
  '@context': string;
  '@graph': Array<Record<string, unknown>>;
} = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://www.dipeshsapkota7.com.np/#author',
      name: 'Dipesh Sapkota',
      alternateName: [
        'Dipesh Sapkota',
        'Dszae',
        'Dipesh Sapkota IOE',
        'Dipesh Sapkota IOE Predictor',
        'Dipesh Sapkota Nepal'
      ],
      url: 'https://www.dipeshsapkota7.com.np/',
      image: `${site}/dipesh-sapkota-profile.webp`,
      jobTitle: 'Software Developer & Creator of IOE Predictor',
      description: 'Dipesh Sapkota is the software developer, creator, and builder of IOE Predictor and IOE Admission Hub, Nepal\'s premier entrance score and rank prediction intelligence platform for Tribhuvan University engineering applicants.',
      nationality: {
        '@type': 'Country',
        name: 'Nepal'
      },
      worksFor: {
        '@type': 'Organization',
        name: 'IOE Admission Hub',
        url: `${site}/`
      },
      sameAs: [
        'https://github.com/Dszae',
        'https://www.linkedin.com/in/dipesh-sapkota/',
        'https://instagram.com/dsz.ae',
        'https://www.dipeshsapkota7.com.np/'
      ],
      knowsAbout: [
        'IOE Predictor',
        'IOE Rank Predictor',
        'IOE Admission Hub',
        'Tribhuvan University IOE Entrance Examination',
        'IOE CBT Scoring & Negative Marking Rules',
        'IOE Cutoff Predictions & Priority Counseling Optimization',
        'Pulchowk Campus Admissions & Seat Matrices',
        'Software Engineering and Web Development in Nepal'
      ]
    },
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      url: `${site}/`,
      name: 'IOE Admission Hub',
      alternateName: [
        'IOE',
        'IOE Admission',
        'IOE Predictor',
        'IOE Entrance',
        'IOE Admission Hub',
        'ioe syllabus',
        'ioe marks',
        'ioe campus',
        'ioe question',
        'ioe fee',
        'IOE Admission Hub by Dipesh Sapkota',
        'IOE Rank Predictor',
        'IOE Guide',
        'TU IOE Admission'
      ],
      description: 'Central admission guide, rank predictor, and counseling intelligence hub for Tribhuvan University Institute of Engineering (IOE) applicants in Nepal by Dipesh Sapkota.',
      isPartOf: {
        '@type': 'WebSite',
        '@id': 'https://www.dipeshsapkota7.com.np/#website',
        name: 'Dipesh Sapkota',
        url: 'https://www.dipeshsapkota7.com.np/'
      },
      publisher: {
        '@id': 'https://www.dipeshsapkota7.com.np/#author'
      },
      author: {
        '@id': 'https://www.dipeshsapkota7.com.np/#author'
      },
      creator: {
        '@id': 'https://www.dipeshsapkota7.com.np/#author'
      },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${site}/predictor/?rank={search_term_string}`
        },
        'query-input': 'required name=search_term_string'
      },
      hasPart: [
        {
          '@type': 'WebPage',
          '@id': `${site}/predictor/#webpage`,
          name: 'IOE Rank Predictor & Historical Cutoffs',
          url: `${site}/predictor/`
        },
        {
          '@type': 'WebPage',
          '@id': `${site}/syllabus/#webpage`,
          name: 'IOE Entrance Syllabus & Exam Pattern',
          url: `${site}/syllabus/`
        },
        {
          '@type': 'WebPage',
          '@id': `${site}/guide/#webpage`,
          name: 'IOE Admission Guide & Counseling Handbook',
          url: `${site}/guide/`
        },
        {
          '@type': 'WebPage',
          '@id': `${site}/campuses/#webpage`,
          name: 'IOE Constituent Campuses & 2,040 Seat Matrix',
          url: `${site}/campuses/`
        },
        {
          '@type': 'WebPage',
          '@id': `${site}/financials/#webpage`,
          name: 'IOE Engineering Tuition Fees & Living Costs',
          url: `${site}/financials/`
        },
        {
          '@type': 'WebPage',
          '@id': `${site}/calculator/#webpage`,
          name: 'IOE CBT Negative Marking Calculator',
          url: `${site}/calculator/`
        },
        {
          '@type': 'WebPage',
          '@id': `${site}/priority/#webpage`,
          name: 'IOE Priority Form Optimizer',
          url: `${site}/priority/`
        },
        {
          '@type': 'WebPage',
          '@id': `${site}/estimator/#webpage`,
          name: 'IOE Score-to-Rank Estimator',
          url: `${site}/estimator/`
        },
        {
          '@type': 'WebPage',
          '@id': `${site}/affiliated/#webpage`,
          name: 'TU-Affiliated Engineering Colleges Directory',
          url: `${site}/affiliated/`
        },
        {
          '@type': 'WebPage',
          '@id': `${site}/compare/#webpage`,
          name: 'Compare IOE Engineering Disciplines & Scope',
          url: `${site}/compare/`
        },
        {
          '@type': 'WebPage',
          '@id': `${site}/checklist/#webpage`,
          name: 'IOE Admission & Verification Checklist',
          url: `${site}/checklist/`
        },
        {
          '@type': 'WebPage',
          '@id': `${site}/notices/#webpage`,
          name: 'IOE Official Admission Notices & Circulars',
          url: `${site}/notices/`
        },
        {
          '@type': 'WebPage',
          '@id': `${site}/profile/#webpage`,
          name: 'Dipesh Sapkota',
          url: `${site}/profile/`
        }
      ]
    },
    {
      '@type': 'ItemList',
      '@id': `${site}/#site-navigation`,
      name: 'IOE Admission Hub Sitelinks Navigation',
      itemListElement: [
        {
          '@type': 'SiteNavigationElement',
          position: 1,
          name: 'IOE Rank Predictor',
          description: 'Compare merit rank against official historical closing ranks across constituent campuses.',
          url: `${site}/predictor/`
        },
        {
          '@type': 'SiteNavigationElement',
          position: 2,
          name: 'IOE Entrance Syllabus',
          description: 'Official 140-mark syllabus breakdown for Mathematics, Physics, Chemistry, and English with exam blueprint.',
          url: `${site}/syllabus/`
        },
        {
          '@type': 'SiteNavigationElement',
          position: 3,
          name: 'IOE CBT Marks Calculator',
          description: 'Calculate exact CBT score out of 140 with official 10% negative marking penalty rules.',
          url: `${site}/calculator/`
        },
        {
          '@type': 'SiteNavigationElement',
          position: 4,
          name: 'IOE Campuses & Seat Matrix',
          description: 'Constituent campus profiles and 2,040 seat matrix capacities for Pulchowk, Thapathali, WRC, ERC, and Chitwan.',
          url: `${site}/campuses/`
        },
        {
          '@type': 'SiteNavigationElement',
          position: 5,
          name: 'IOE Fee Structure & Costs',
          description: 'Official 4-year tuition fee breakdown across Regular, Full Fee, and hostel cost estimates.',
          url: `${site}/financials/`
        },
        {
          '@type': 'SiteNavigationElement',
          position: 6,
          name: 'IOE Admission Guide',
          description: 'Step-by-step IOE counseling rules, merit-list rounds, auto-upgrades, and document verification.',
          url: `${site}/guide/`
        },
        {
          '@type': 'SiteNavigationElement',
          position: 7,
          name: 'IOE Priority Form Optimizer',
          description: 'Build algorithmic Reach, Target, and Safety counseling preferences with cutoff benchmarks.',
          url: `${site}/priority/`
        },
        {
          '@type': 'SiteNavigationElement',
          position: 8,
          name: 'IOE Score-to-Rank Estimator',
          description: 'Estimate historical IOE entrance merit-rank brackets from raw CBT entrance scores.',
          url: `${site}/estimator/`
        },
        {
          '@type': 'SiteNavigationElement',
          position: 9,
          name: 'TU-Affiliated Colleges',
          description: 'Directory, programs, and estimated fee comparisons for 10 TU-affiliated private engineering colleges.',
          url: `${site}/affiliated/`
        },
        {
          '@type': 'SiteNavigationElement',
          position: 10,
          name: 'Compare Engineering Disciplines',
          description: 'In-depth syllabus, core subject overlap, lab workshops, and career pathways across 12 disciplines.',
          url: `${site}/compare/`
        },
        {
          '@type': 'SiteNavigationElement',
          position: 11,
          name: 'Admission Checklist',
          description: 'Step-by-step interactive checklist from entrance application to physical campus verification.',
          url: `${site}/checklist/`
        },
        {
          '@type': 'SiteNavigationElement',
          position: 12,
          name: 'Official Notices & Circulars',
          description: 'Direct links and summaries of authentic IOE entrance examination notices, circulars, and merit lists.',
          url: `${site}/notices/`
        },
        {
          '@type': 'SiteNavigationElement',
          position: 13,
          name: 'Dipesh Sapkota',
          description: 'Profile and background of Dipesh Sapkota, creator and builder of IOE Admission Hub.',
          url: `${site}/profile/`
        }
      ]
    },
    {
      '@type': schemaType,
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: 'en',
      isPartOf: {
        '@id': `${site}/#website`
      },
      author: {
        '@id': 'https://www.dipeshsapkota7.com.np/#author'
      },
      creator: {
        '@id': 'https://www.dipeshsapkota7.com.np/#author'
      },
      ...(isProfile ? {
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: `${site}/dipesh-sapkota-profile.webp`,
          caption: 'Dipesh Sapkota — Creator of IOE Admission Hub'
        },
        mainEntity: {
          '@id': 'https://www.dipeshsapkota7.com.np/#author'
        },
        about: {
          '@id': 'https://www.dipeshsapkota7.com.np/#author'
        }
      } : {}),
      breadcrumb: {
        '@id': `${canonical}#breadcrumbs`
      }
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumbs`,
      itemListElement: breadcrumbElements
    }
  ]
};

if (isPredictor || isCalculator) {
  structuredData['@graph'].push({
    '@type': 'WebApplication',
    '@id': `${canonical}#app`,
    name: title,
    url: canonical,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript. Requires HTML5.',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'NPR'
    },
    author: {
      '@id': 'https://www.dipeshsapkota7.com.np/#author'
    },
    creator: {
      '@id': 'https://www.dipeshsapkota7.com.np/#author'
    },
    publisher: {
      '@id': 'https://www.dipeshsapkota7.com.np/#author'
    }
  });
}

if (isGuide) {
  structuredData['@graph'].push({
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How does the IOE entrance CBT negative marking system work?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The IOE CBT entrance exam totals 140 marks with a 10% penalty for incorrect answers: -0.1 mark per wrong 1-mark question and -0.2 mark per wrong 2-mark question. Unattempted questions incur no penalty. A minimum of 40% (56 marks) is strictly required to pass.'
        }
      },
      {
        '@type': 'Question',
        name: 'How does the IOE auto-upgrade counseling system work?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'When a candidate is allotted a seat of a lower priority preference in an earlier merit list round, any seat vacancy in their higher priority choices automatically shifts them upward in subsequent rounds. Downgrading to a lower preference is not permitted.'
        }
      },
      {
        '@type': 'Question',
        name: 'What documents are required for IOE physical campus verification?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Candidates must submit their IOE entrance admit card, original citizenship or national ID, SLC/SEE grade sheet & character certificate, +2/diploma transcript & migration certificate, 4 passport photos, and official quota endorsement letters if claiming affirmative action seats.'
        }
      }
    ]
  });
}

if (isProfile) {
  structuredData['@graph'].push({
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Who created the IOE Predictor?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The IOE Predictor and IOE Admission Hub platform were created and developed by Dipesh Sapkota, a software developer from Kathmandu, Nepal, to provide transparent cutoff analytics, CBT score calculators, and counseling intelligence for Tribhuvan University engineering applicants.'
        }
      },
      {
        '@type': 'Question',
        name: 'Who is Dipesh Sapkota?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Dipesh Sapkota is a software engineer, web developer, and the creator of IOE Admission Hub (IOE Predictor). He specializes in building accessible, data-driven web tools for education and open-source applications in Nepal.'
        }
      },
      {
        '@type': 'Question',
        name: 'What tools has Dipesh Sapkota built for IOE applicants?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Dipesh Sapkota developed the IOE Merit Rank Predictor, CBT Negative Marking Calculator (140-mark test engine), Priority Form Sequence Optimizer, Score-to-Rank Estimator, 2,040 Constituent Seat Matrix Explorer, and Fee Structure Breakdown.'
        }
      },
      {
        '@type': 'Question',
        name: 'How can I connect with Dipesh Sapkota?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'You can connect with Dipesh Sapkota via his official website (https://www.dipeshsapkota7.com.np/), GitHub (@Dszae), LinkedIn (in/dipesh-sapkota), and Instagram (@dsz.ae).'
        }
      }
    ]
  });
}

if (isSyllabus) {
  structuredData['@graph'].push({
    '@type': 'Course',
    '@id': `${canonical}#course`,
    name: 'Tribhuvan University IOE Undergraduate Entrance Examination Syllabus',
    description: 'Official chapter-wise syllabus for IOE entrance examination in Nepal: Mathematics (50 marks), Physics (45 marks), Chemistry (25 marks), and English (20 marks) totaling 140 marks.',
    provider: {
      '@type': 'Organization',
      name: 'Institute of Engineering (IOE), Tribhuvan University'
    },
    educationalCredentialAwarded: 'IOE B.E. / B.Arch. Entrance Eligibility'
  });

  structuredData['@graph'].push({
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is the syllabus for the IOE entrance examination?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The IOE entrance examination syllabus covers 4 subjects: Mathematics (50 marks, 36 questions), Physics (45 marks, 33 questions), Chemistry (25 marks, 17 questions), and English (20 marks, 14 questions). Total exam marks is 140 with 100 multiple choice questions.'
        }
      },
      {
        '@type': 'Question',
        name: 'What is the question pattern and marking scheme for IOE CBT?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The 2-hour CBT exam has 100 questions divided into Section A (60 questions of 1 mark each with 0.1 negative mark) and Section B (40 questions of 2 marks each with 0.2 negative mark). Passing requires at least 40% (56 marks).'
        }
      },
      {
        '@type': 'Question',
        name: 'What are the highest weightage topics in IOE entrance?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'In Mathematics, Calculus and Coordinate Geometry contribute over 20 marks. In Physics, Mechanics and Electricity & Magnetism contribute over 24 marks. In Chemistry, Physical and Organic chemistry dominate with ~19 marks. English provides 20 high-efficiency marks.'
        }
      }
    ]
  });
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1e40af" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/png" href="/ioe-logo.png" />
    <link rel="alternate icon" type="image/png" href="/ioe logo.png" />
    <link rel="apple-touch-icon" href="/ioe-logo.png" />
    <link rel="author" href="https://www.dipeshsapkota7.com.np/" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Full context for AI agents" />

    <!-- Google Fonts: Manrope & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Dipesh Sapkota" />
    <meta name="creator" content="Dipesh Sapkota" />
    <meta name="publisher" content="Dipesh Sapkota" />
    <meta name="keywords" content={isProfile ? "Dipesh Sapkota, Dipesh Sapkota IOE, Dipesh Sapkota IOE Predictor, IOE Predictor Creator, Who created IOE Predictor, IOE Admission Hub Creator, Dipesh Sapkota Developer Nepal, Dszae, IOE Rank Predictor Dipesh" : isSyllabus ? "ioe syllabus, IOE entrance syllabus, ioe marks, ioe question, ioe exam pattern, IOE physics syllabus, IOE mathematics syllabus, IOE chemistry syllabus, IOE english syllabus, IOE, IOE entrance, IOE entrance blueprint" : "IOE, IOE admission, IOE predictor, IOE entrance, IOE admission hub, ioe syllabus, ioe marks, ioe campus, ioe question, ioe fee, IOE Pulchowk, IOE Cutoff, IOE CBT Calculator, IOE Fee Structure, Institute of Engineering Nepal, Tribhuvan University IOE, Dipesh Sapkota"} />
    <meta name="geo.region" content="NP" />
    <meta name="geo.placename" content="Kathmandu, Nepal" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="google-site-verification" content="wtQe5iJTyPSo0Nrj7GN4IteUky0stRBG7tIB1Lu92P8" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IOE Admission Hub" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={isProfile ? `${site}/dipesh-sapkota-profile.webp` : `${site}/og-image.png`} />
    <meta property="og:image:width" content={isProfile ? "800" : "1200"} />
    <meta property="og:image:height" content={isProfile ? "800" : "630"} />
    <meta property="og:image:alt" content={isProfile ? "Dipesh Sapkota — Creator of IOE Admission Hub" : "IOE Admission Hub by Dipesh Sapkota"} />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:site" content="@Dszae" />
    <meta property="twitter:creator" content="@Dszae" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={isProfile ? `${site}/dipesh-sapkota-profile.webp` : `${site}/og-image.png`} />
    <meta property="twitter:image:alt" content={isProfile ? "Dipesh Sapkota — Creator of IOE Admission Hub" : "IOE Admission Hub by Dipesh Sapkota"} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="bg-slate-50 text-slate-800 font-sans min-h-screen">
    <h1 class="sr-only">{heading}</h1>
    <slot />
  </body>
</html>
